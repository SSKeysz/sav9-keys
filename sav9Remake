    -- ===== VERIFICAÇÃO (ORIGINAL - NÃO ALTERAR) =====
    local function verificarKey(key)
        if key == "" and savedKey ~= "" then
            key = savedKey
        end
        key = key:gsub("^%s+", ""):gsub("%s+$", "")
        if key == "" then
            statusLbl.Text = " Insira uma chave."
            statusLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
            return false
        end

        statusLbl.Text = "⏳ Verificando..."
        statusLbl.TextColor3 = Color3.fromRGB(255, 200, 50)

        local reqFn = syn and syn.request or (http and http.request) or (typeof(http_request) == "function" and http_request) or (typeof(request) == "function" and request) or nil
        if not reqFn then
            statusLbl.Text = " Executor sem suporte a request()."
            statusLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
            return false
        end

        local ok, res = pcall(reqFn, {
            Url = "https://fjflvzbbqfkwkkmerexc.supabase.co/rest/v1/chaves?key=eq." .. key .. "&select=key,user_id,expira,tipo",
            Method = "GET",
            Headers = {
                ["apikey"] = "sb_publishable_NMJdEibVTmsm6WtfuSjARw_37ChaSza",
                ["Authorization"] = "Bearer sb_publishable_NMJdEibVTmsm6WtfuSjARw_37ChaSza",
                ["Content-Type"] = "application/json"
            }
        })

        if not ok then
            statusLbl.Text = " Erro ao conectar ao servidor."
            statusLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
            return false
        end

        local body = res and (res.Body or res.body) or ""
        if not body or body == "" then
            statusLbl.Text = " Sem resposta do servidor."
            statusLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
            return false
        end

        local parseOk, data = pcall(HttpService.JSONDecode, HttpService, body)
        if not parseOk or not data or #data == 0 then
            statusLbl.Text = " Chave inválida ou não cadastrada."
            statusLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
            return false
        end

        local keyData = data[1]
        local expira = keyData.expira or "2000-01-01"
        local expirado = false
        local ano, mes, dia = expira:match("(%d+)-(%d+)-(%d+)")
        if ano then
            ano, mes, dia = tonumber(ano), tonumber(mes), tonumber(dia)
            local hoje = os.date("*t")
            expirado = ano < hoje.year or (ano == hoje.year and mes < hoje.month) or (ano == hoje.year and mes == hoje.month and dia < hoje.day)
        end

        if expirado then
            pcall(function()
                if isfile(KEY_FILE) then writefile(KEY_FILE, "") end
            end)
            statusLbl.Text = " Chave expirada! Adquira uma nova."
            statusLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
            return false
        end

        local userId = keyData.user_id or ""

        if userId == "free" then
            statusLbl.Text = " Chave FREE - acesso liberado!"
            statusLbl.TextColor3 = Color3.fromRGB(80, 255, 140)
        elseif userId == "" or userId == nil then
            task.spawn(function()
                pcall(reqFn, {
                    Url = "https://fjflvzbbqfkwkkmerexc.supabase.co/rest/v1/chaves?key=eq." .. key,
                    Method = "PATCH",
                    Headers = {
                        ["apikey"] = "sb_publishable_NMJdEibVTmsm6WtfuSjARw_37ChaSza",
                        ["Authorization"] = "Bearer sb_publishable_NMJdEibVTmsm6WtfuSjARw_37ChaSza",
                        ["Content-Type"] = "application/json",
                        ["Prefer"] = "return=representation"
                    },
                    Body = HttpService:JSONEncode({ user_id = myUserId })
                })
            end)
            statusLbl.Text = " Chave vinculada à sua conta!"
            statusLbl.TextColor3 = Color3.fromRGB(80, 255, 140)
        elseif userId ~= myUserId then
            statusLbl.Text = " Chave vinculada a outra conta!"
            statusLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
            return false
        else
            statusLbl.Text = " Chave válida! Tipo: " .. (keyData.tipo or "?"):upper()
            statusLbl.TextColor3 = Color3.fromRGB(80, 255, 140)
        end

        pcall(function()
            if not isfolder("PoloSniperFinal") then makefolder("PoloSniperFinal") end
            writefile(KEY_FILE, key)
        end)
        return true
    end

    local function onConfirm()
        confirmBtn.Active = false
        confirmBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 180)
        confirmBtn.Text = "Verificando..."
        local inputKey = keyInput.Text
        if inputKey == "" and savedKey ~= "" then
            inputKey = savedKey
        end
        if verificarKey(inputKey) then
            keyValid = true
            task.wait(1)
            keyGui:Destroy()
        else
            confirmBtn.Active = true
            confirmBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            confirmBtn.Text = " Confirmar Chave"
        end
    end

    confirmBtn.MouseButton1Click:Connect(onConfirm)
    keyInput.FocusLost:Connect(function(enter)
        if enter then onConfirm() end
    end)

    if savedKey ~= "" then
        task.spawn(function()
            task.wait(0.5)
            onConfirm()
        end)
    end

    local elapsed = 0
    repeat
        task.wait(0.1)
        elapsed = elapsed + 0.1
    until keyValid or elapsed >= 180 or not keyGui.Parent

    if not keyValid then
        pcall(function() keyGui:Destroy() end)
        return false
    end
    return true
end

