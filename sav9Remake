    btn.Size = UDim2.new(0.6, -10, 0, 28)
    btn.Position = UDim2.new(0.4, 0, 0.5, -14)
    btn.BackgroundColor3 = Theme.Card
    btn.BackgroundTransparency = 0.3
    btn.BorderSizePixel = 0
    btn.Text = defaultOption or options[1] or "Selecione"
    btn.TextColor3 = Theme.Text
    btn.TextSize = 12
    btn.Font = Enum.Font.SourceSans
    btn.ZIndex = 20
    CreateCorner(btn, 6)
    CreateStroke(btn, Theme.Border, 0.5)
    
    local selected = defaultOption or options[1] or ""
    local open = false
    local list = nil
    local dropdownRef = {}
    local optionsList = options
    
    local function Close()
        if list then
            list:Destroy()
            list = nil
        end
        open = false
        for i, ref in pairs(activeDropdowns) do
            if ref == dropdownRef then
                table.remove(activeDropdowns, i)
                break
            end
        end
    end
    
    local function Open()
        if open then
            Close()
            return
        end
        
        CloseAllDropdowns(dropdownRef)
        open = true
        table.insert(activeDropdowns, dropdownRef)
        
        local dropdownGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
        dropdownGui.Name = "SAV9_Dropdown_" .. tostring(tick())
        dropdownGui.ResetOnSpawn = false
        dropdownGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        dropdownGui.DisplayOrder = 200
        
        list = Instance.new("Frame", dropdownGui)
        list.Size = UDim2.new(0, 0, 0, 0)
        list.BackgroundColor3 = Theme.Card
        list.BackgroundTransparency = 0.1
        list.BorderSizePixel = 0
        list.ClipsDescendants = false
        list.ZIndex = 50
        CreateCorner(list, 6)
        CreateStroke(list, Theme.Border, 0.5)
        
        local btnAbsPos = btn.AbsolutePosition
        local btnAbsSize = btn.AbsoluteSize
        local containerAbsPos = container.AbsolutePosition
        local containerAbsSize = container.AbsoluteSize
        local sH = workspace.CurrentCamera.ViewportSize.Y
        
        local maxItems = #optionsList
        local itemHeight = 26
        local maxHeight = math.min(maxItems * itemHeight, 140)
        if maxItems == 0 then maxHeight = 40 end
        
        local xPos = containerAbsPos.X + (containerAbsSize.X * 0.4) + 4
        local yPos = btnAbsPos.Y + btnAbsSize.Y + 2
        local listWidthPx = math.max(120, containerAbsSize.X * 0.6 - 12)
        local spaceDown = sH - yPos - 10
        local spaceUp = btnAbsPos.Y - 10
        
        if spaceDown < maxHeight and spaceUp > maxHeight then
            yPos = btnAbsPos.Y - maxHeight - 2
        end
        
        list.Position = UDim2.new(0, xPos, 0, yPos)
        list.Size = UDim2.new(0, listWidthPx, 0, math.min(maxHeight, sH - yPos - 10))
        
        local scrollFrame = Instance.new("ScrollingFrame", list)
        scrollFrame.Size = UDim2.new(1, 0, 1, 0)
        scrollFrame.Position = UDim2.new(0, 0, 0, 0)
        scrollFrame.BackgroundTransparency = 1
        scrollFrame.BorderSizePixel = 0
        scrollFrame.ScrollBarThickness = 4
        scrollFrame.ScrollBarImageColor3 = Theme.Scrollbar
        scrollFrame.ScrollBarImageTransparency = 0.2
        scrollFrame.VerticalScrollBarPosition = Enum.VerticalScrollBarPosition.Right
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, #optionsList * itemHeight + 4)
        scrollFrame.ZIndex = 50
        scrollFrame.ClipsDescendants = true
        
        local innerContainer = Instance.new("Frame", scrollFrame)
        innerContainer.Size = UDim2.new(1, 0, 0, 0)
        innerContainer.Position = UDim2.new(0, 0, 0, 0)
        innerContainer.BackgroundTransparency = 1
        innerContainer.ZIndex = 50
        innerContainer.AutomaticSize = Enum.AutomaticSize.Y
        
        local innerLayout = Instance.new("UIListLayout", innerContainer)
        innerLayout.SortOrder = Enum.SortOrder.LayoutOrder
        innerLayout.Padding = UDim.new(0, 1)
        
        if #optionsList == 0 then
            local empty = Instance.new("TextLabel", innerContainer)
            empty.Size = UDim2.new(1, 0, 0, itemHeight)
            empty.BackgroundTransparency = 1
            empty.Text = "Sem opções"
            empty.TextColor3 = Theme.TextSecondary
            empty.TextSize = 12
            empty.Font = Enum.Font.SourceSans
            empty.ZIndex = 50
        else
            for _, opt in ipairs(optionsList) do
                local b = Instance.new("TextButton", innerContainer)
                b.Size = UDim2.new(1, 0, 0, itemHeight)
                b.BackgroundColor3 = Theme.Card
                b.BackgroundTransparency = 1
                b.BorderSizePixel = 0
                b.Text = opt
                b.TextColor3 = Theme.Text
                b.TextSize = 12
                b.Font = Enum.Font.SourceSans
                b.ZIndex = 50
                b.MouseEnter:Connect(function() b.BackgroundTransparency = 0.2 end)
                b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
                b.MouseButton1Click:Connect(function()
                    selected = opt
                    btn.Text = opt
                    Close()
                    if callback then callback(opt) end
                    if flag then saveConfig() end
                end)
            end
        end
        
        task.wait(0.05)
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, innerContainer.AbsoluteSize.Y.Offset + 4)
        
        local closeConnection = nil
        closeConnection = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 and open and list then
                local mp = V2new(Mouse.X, Mouse.Y)
                local p = list.AbsolutePosition
                local s = list.AbsoluteSize
                local btnP = btn.AbsolutePosition
                local btnS = btn.AbsoluteSize
                
                local inList = (mp.X >= p.X and mp.X <= p.X + s.X and mp.Y >= p.Y and mp.Y <= p.Y + s.Y)
                local inBtn = (mp.X >= btnP.X and mp.X <= btnP.X + btnS.X and mp.Y >= btnP.Y and mp.Y <= btnP.Y + btnS.Y)
                
                if not inList and not inBtn then
                    Close()
                    if closeConnection then closeConnection:Disconnect() end
                end
            end
        end)
        
        local focusConnection = nil
        focusConnection = dropdownGui:GetPropertyChangedSignal("Enabled"):Connect(function()
            if not dropdownGui.Enabled then
                Close()
                if closeConnection then closeConnection:Disconnect() end
                if focusConnection then focusConnection:Disconnect() end
            end
        end)
        
        local scrollConnection = nil
        scrollConnection = MainUI.ContentArea:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
            if open then
                Close()
                if closeConnection then closeConnection:Disconnect() end
                if focusConnection then focusConnection:Disconnect() end
                if scrollConnection then scrollConnection:Disconnect() end
            end
        end)
        
        dropdownRef._cleanup = function()
            if closeConnection then pcall(closeConnection.Disconnect, closeConnection) end
            if focusConnection then pcall(focusConnection.Disconnect, focusConnection) end
            if scrollConnection then pcall(scrollConnection.Disconnect, scrollConnection) end
        end
    end
    
    btn.MouseButton1Click:Connect(Open)
    
    local el = {
        Set = function(_, v)
            selected = v
            btn.Text = v
            if callback then callback(v) end
        end,
        Get = function() return selected end,
        Refresh = function(_, newOpts, keep)
            if newOpts then
                optionsList = newOpts
                local found = false
                for _, opt in ipairs(newOpts) do
                    if opt == selected then
                        found = true
                        break
                    end
                end
                if not found and not keep then
                    selected = newOpts[1] or ""
                    btn.Text = selected
                end
            end
        end,
        Close = Close,
        _ref = dropdownRef
    }
    
    dropdownRef.Close = Close
    dropdownRef._el = el
    
    if flag then UIElements[flag] = el end
    return el
end

