local function isPlayerAlive(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    return hum.Health > 0 and hum.Health <= hum.MaxHealth
end

local function GetClosest()
    local closest = nil
    local dist = math.huge
    local mouse = UserInputService:GetMouseLocation()
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LocalPlayer or not plr.Character then continue end
        if not isPlayerAlive(plr) then continue end
        if not plr.Character:FindFirstChild("Head") then continue end
        if aimbotUseTargetList and next(aimbotTargetList) ~= nil and not aimbotTargetList[plr.Name] then continue end
        if aimbotWhitelist[plr.Name] then continue end
        if Settings.AimbotCheckTeam and LocalPlayer.Team and plr.Team == LocalPlayer.Team then continue end
        
        local char = plr.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        
        local boneMap = {["Cabeça"] = "Head", Peito = "UpperTorso", ["Perna Esquerda"] = "LeftUpperLeg"}
        local bone = char:FindFirstChild(boneMap[Settings.AimbotBone] or "Head") or char:FindFirstChild("Head")
        if not bone then continue end
        
        local sp, on = Camera:WorldToViewportPoint(bone.Position)
        if not on or sp.Z <= 0 then continue end
        
        if Settings.AimbotMaxDistEnabled and cachedHRP then
            local ad = (cachedHRP.Position - bone.Position).Magnitude
            if ad > Settings.AimbotMaxDist then continue end
        end
        
        local dx = sp.X - mouse.X
        local dy = sp.Y - mouse.Y
        local d = math.sqrt(dx * dx + dy * dy)
        
        if d < Settings.AimbotFOV and d < dist then
            if Settings.VisCheck then
                local parts = Camera:GetPartsObscuringTarget({bone.Position}, {cachedChar, char})
                if #parts > 0 then continue end
            end
            dist = d
            closest = plr
        end
    end
    return closest
end

