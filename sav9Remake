    CreateCorner(container, 8)
    CreateStroke(container, Theme.Border, 0.5)
    
    local label = Instance.new("TextLabel", container)
    label.Size = UDim2.new(0.6, -10, 0, 20)
    label.Position = UDim2.new(0, 10, 0, 2)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Theme.Text
    label.TextSize = 12
    label.Font = Enum.Font.SourceSans
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 5
    
    local valLabel = Instance.new("TextLabel", container)
    valLabel.Size = UDim2.new(0.4, -10, 0, 20)
    valLabel.Position = UDim2.new(0.6, 0, 0, 2)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = tostring(defaultValue or min)
    valLabel.TextColor3 = Theme.Primary
    valLabel.TextSize = 12
    valLabel.Font = Enum.Font.SourceSansBold
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.ZIndex = 5
    
    local track = Instance.new("Frame", container)
    track.Size = UDim2.new(1, -20, 0, 3)
    track.Position = UDim2.new(0, 10, 0, 38)
    track.BackgroundColor3 = Theme.ToggleOff
    track.BorderSizePixel = 0
    track.ZIndex = 5
    CreateCorner(track, 2)
    
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Theme.Primary
    fill.BorderSizePixel = 0
    fill.ZIndex = 5
    CreateCorner(fill, 2)
    
    local value = defaultValue or min
    local range = max - min
    local dragging = false
    
    local function Update()
        local p = (value - min) / range
        fill.Size = UDim2.new(p, 0, 1, 0)
        valLabel.Text = tostring(math.round(value * 100) / 100)
    end
    
    local function SetValue(nv)
        value = math.clamp(nv, min, max)
        if increment and increment > 0 then value = math.round(value / increment) * increment end
        Update()
        if callback then callback(value) end
        if flag then saveConfig() end
    end
    
    local function UpdateMouse()
        local mp = Mouse.X - track.AbsolutePosition.X
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        SetValue(min + math.clamp(mp / w, 0, 1) * range)
    end
    
    track.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; UpdateMouse() end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then UpdateMouse() end end)
    SetValue(defaultValue or min)
    
    local el = {Set = SetValue, Get = function() return value end}
    if flag then UIElements[flag] = el end
    return el
end

