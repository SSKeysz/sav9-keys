local spectateTimer = 0
local gluedTimer = 0
local serverTimer = 0
local hudSlowTimer = 0
local noclipTimer = 0

RunService.RenderStepped:Connect(function()
    if not Injected then return end
    linePoolIdx = 0
    textPoolIdx = 0
    
    if Settings.AimbotCam and Settings.AimbotFOVCircle and fovCircle then
        local vp = Camera.ViewportSize
        fovCircle.Visible = true
        fovCircle.Position = V2new(vp.X / 2, vp.Y / 2)
        fovCircle.Radius = Settings.AimbotFOV
        fovCircle.Transparency = Settings.AimbotFOVOpacity
    elseif fovCircle then
        fovCircle.Visible = false
    end
    
    local anyESP = Settings.ESP_Box or Settings.ESP_Skeleton or Settings.ESP_Line or Settings.ESP_Name or Settings.ShowDistance
    local rgbNow = (Settings.ESP_Box_RGB or Settings.ESP_Skeleton_RGB or Settings.ESP_Line_RGB) and GetRGB() or nil
    
    if anyESP then
        local skeletonColor = Settings.ESP_Skeleton_RGB and rgbNow or Settings.ESP_Skeleton_Color
        local lineColor = Settings.ESP_Line_RGB and rgbNow or Settings.ESP_Line_Color
        local boxColor = Settings.ESP_Box_RGB and rgbNow or Settings.ESP_Box_Color
        local skelThick = Settings.SkeletonThickness
        local lineThick = Settings.LineThickness
        local vp = Camera.ViewportSize
        local viewX = vp.X
        local viewY = vp.Y
        local halfX = viewX * 0.5
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr == LocalPlayer or not plr.Character then continue end
            if not isPlayerAlive(plr) then
                if boxHighlights[plr.Character] then 
                    boxHighlights[plr.Character]:Destroy()
                    boxHighlights[plr.Character] = nil
                end
                continue
            end
            
            local char = plr.Character
            local head = char:FindFirstChild("Head")
            local root = char:FindFirstChild("HumanoidRootPart")
            if not (head and root) then continue end
            
            if cachedHRP then
                local espDist = (cachedHRP.Position - root.Position).Magnitude
                if Settings.ESPMaxDistEnabled and espDist > Settings.ESPMaxDist then
                    if boxHighlights[char] then boxHighlights[char]:Destroy(); boxHighlights[char] = nil end
                    continue
                end
            end
            if Settings.ESPCheckTeam and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
                if boxHighlights[char] then boxHighlights[char]:Destroy(); boxHighlights[char] = nil end
                continue
            end
            
            local headScreen, headOn = Camera:WorldToViewportPoint(head.Position + V3new(0, 3, 0))
            if not headOn then
                if boxHighlights[char] then boxHighlights[char]:Destroy(); boxHighlights[char] = nil end
                continue
            end
            if Settings.VisCheck then
                local parts = Camera:GetPartsObscuringTarget({head.Position}, {cachedChar, char})
                if #parts > 0 then continue end
            end
            
            local rootScreen, rootOn = Camera:WorldToViewportPoint(root.Position)
            local rootScreenSafe = rootOn and rootScreen.Z > 0.5 and rootScreen.X > -500 and rootScreen.X < viewX + 500 and rootScreen.Y > -500 and rootScreen.Y < viewY + 500
            
            if Settings.ESP_Name then
                local t = acquireText()
                local nameStr = Settings.ESP_NameStyle == "Nome de Exibição" and (plr.DisplayName or plr.Name) or plr.Name
                t.Text = nameStr
                t.Size = 16
                t.Color = WHITE
                t.Center = true
                t.Outline = true
                t.OutlineColor = BLACK
                t.Position = V2new(headScreen.X, headScreen.Y - 50)
            end
            
            if Settings.ESP_Box then
                if Settings.ESP_BoxStyle == "Highlight" then
                    local hl = boxHighlights[char]
                    if not hl or not hl.Parent then
                        if hl then hl:Destroy() end
                        hl = Instance.new("Highlight", char)
                        hl.Name = "SAV9_ESP"
                        hl.FillColor = boxColor
                        hl.OutlineColor = WHITE
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        boxHighlights[char] = hl
                    end
                    if hl.FillColor ~= boxColor then hl.FillColor = boxColor end
                else
                    if boxHighlights[char] then boxHighlights[char]:Destroy(); boxHighlights[char] = nil end
                    if rootScreenSafe and headScreen.Z > 0 then
                        local bodyH = math.max(10, rootScreen.Y - headScreen.Y)
                        local halfW = bodyH * 0.45
                        local x1 = rootScreen.X - halfW
                        local y1 = headScreen.Y - bodyH * 0.1
                        local x2 = rootScreen.X + halfW
                        local y2 = rootScreen.Y + bodyH
                        local w = math.abs(x2 - x1)
                        local h = math.abs(y2 - y1)
                        
                        if Settings.ESP_BoxStyle == "2D Box" then
                            local lt = acquireLine()
                            lt.Color = boxColor
                            lt.Thickness = 1.5
                            local rt = acquireLine()
                            rt.Color = boxColor
                            rt.Thickness = 1.5
                            local tp = acquireLine()
                            tp.Color = boxColor
                            tp.Thickness = 1.5
                            local bt = acquireLine()
                            bt.Color = boxColor
                            bt.Thickness = 1.5
                            lt.From = V2new(x1, y1)
                            lt.To = V2new(x1, y2)
                            rt.From = V2new(x2, y1)
                            rt.To = V2new(x2, y2)
                            tp.From = V2new(x1, y1)
                            tp.To = V2new(x2, y1)
                            bt.From = V2new(x1, y2)
                            bt.To = V2new(x2, y2)
                        elseif Settings.ESP_BoxStyle == "2D Corner" then
                            local cs = math.min(w, h) * 0.25
                            local c1a = acquireLine()
                            c1a.Color = boxColor
                            c1a.Thickness = 2
                            local c1b = acquireLine()
                            c1b.Color = boxColor
                            c1b.Thickness = 2
                            local c2a = acquireLine()
                            c2a.Color = boxColor
                            c2a.Thickness = 2
                            local c2b = acquireLine()
                            c2b.Color = boxColor
                            c2b.Thickness = 2
                            local c3a = acquireLine()
                            c3a.Color = boxColor
                            c3a.Thickness = 2
                            local c3b = acquireLine()
                            c3b.Color = boxColor
                            c3b.Thickness = 2
                            local c4a = acquireLine()
                            c4a.Color = boxColor
                            c4a.Thickness = 2
                            local c4b = acquireLine()
                            c4b.Color = boxColor
                            c4b.Thickness = 2
                            c1a.From = V2new(x1, y1)
                            c1a.To = V2new(x1 + cs, y1)
                            c1b.From = V2new(x1, y1)
                            c1b.To = V2new(x1, y1 + cs)
                            c2a.From = V2new(x2, y1)
                            c2a.To = V2new(x2 - cs, y1)
                            c2b.From = V2new(x2, y1)
                            c2b.To = V2new(x2, y1 + cs)
                            c3a.From = V2new(x1, y2)
                            c3a.To = V2new(x1 + cs, y2)
                            c3b.From = V2new(x1, y2)
                            c3b.To = V2new(x1, y2 - cs)
                            c4a.From = V2new(x2, y2)
                            c4a.To = V2new(x2 - cs, y2)
                            c4b.From = V2new(x2, y2)
                            c4b.To = V2new(x2, y2 - cs)
                        elseif Settings.ESP_BoxStyle == "3D Box" then
                            local hrp3 = char:FindFirstChild("HumanoidRootPart")
                            if hrp3 then
                                local cf = hrp3.CFrame
                                local sx = 2
                                local sy = 5
                                local sz = 2
                                local verts = {
                                    cf * Vector3.new(-sx / 2, sy / 2, -sz / 2),
                                    cf * Vector3.new(sx / 2, sy / 2, -sz / 2),
                                    cf * Vector3.new(sx / 2, sy / 2, sz / 2),
                                    cf * Vector3.new(-sx / 2, sy / 2, sz / 2),
                                    cf * Vector3.new(-sx / 2, -sy / 2, -sz / 2),
                                    cf * Vector3.new(sx / 2, -sy / 2, -sz / 2),
                                    cf * Vector3.new(sx / 2, -sy / 2, sz / 2),
                                    cf * Vector3.new(-sx / 2, -sy / 2, sz / 2),
                                }
                                local sv = {}
                                local allOn = true
                                for k, v3 in ipairs(verts) do
                                    local sp2, on2 = Camera:WorldToViewportPoint(v3)
                                    if not on2 or sp2.Z <= 0 then
                                        allOn = false
                                        break
                                    end
                                    sv[k] = V2new(sp2.X, sp2.Y)
                                end
                                if allOn then
                                    local edges = {
                                        {1,2}, {2,3}, {3,4}, {4,1},
                                        {5,6}, {6,7}, {7,8}, {8,5},
                                        {1,5}, {2,6}, {3,7}, {4,8}
                                    }
                                    for _, e in ipairs(edges) do
                                        local el = acquireLine()
                                        el.Color = boxColor
                                        el.Thickness = 1.5
                                        el.From = sv[e[1]]
                                        el.To = sv[e[2]]
                                    end
                                end
                            end
                        end
                    end
                end
            elseif boxHighlights[char] then
                boxHighlights[char]:Destroy()
                boxHighlights[char] = nil
            end
            
            if Settings.ESP_Skeleton then
                local b = getBones(char)
                if b.torso then
                    local function pb(a, bx)
                        if not (a and bx) then return end
                        local p1, v1 = Camera:WorldToViewportPoint(a.Position)
                        local p2, v2 = Camera:WorldToViewportPoint(bx.Position)
                        if v1 and v2 and p1.Z > 0 and p2.Z > 0 then
                            local ln = acquireLine()
                            ln.Color = skeletonColor
                            ln.Thickness = skelThick
                            ln.From = V2new(p1.X, p1.Y)
                            ln.To = V2new(p2.X, p2.Y)
                        end
                    end
                    pb(b.head, b.torso)
                    pb(b.torso, b.lUA)
                    pb(b.torso, b.rUA)
                    pb(b.lUA, b.lLA)
                    pb(b.lLA, b.lH)
                    pb(b.rUA, b.rLA)
                    pb(b.rLA, b.rH)
                    if b.lTorso then
                        pb(b.torso, b.lTorso)
                        pb(b.lTorso, b.lUL)
                        pb(b.lUL, b.lLL)
                        pb(b.lLL, b.lF)
                        pb(b.lTorso, b.rUL)
                        pb(b.rUL, b.rLL)
                        pb(b.rLL, b.rF)
                    end
                end
            end
            
            if Settings.ESP_Line and rootScreenSafe then
                local ln = acquireLine()
                ln.Color = lineColor
                ln.Thickness = lineThick
                local fromY = Settings.LineESPPos == "Topo" and 0 or viewY
                ln.From = V2new(halfX, fromY)
                ln.To = V2new(rootScreen.X, rootScreen.Y)
            end
            
            if Settings.ShowDistance and cachedHRP then
                local dist = (cachedHRP.Position - root.Position).Magnitude
                if headScreen.Z > 1 and dist > 1 then
                    local dt = acquireText()
                    dt.Text = mfloor(dist) .. "m"
                    dt.Size = 16
                    dt.Color = WHITE
                    dt.Center = true
                    dt.Outline = true
                    dt.OutlineColor = BLACK
                    dt.Position = V2new(headScreen.X, headScreen.Y - 30)
                end
            end
            
            if Settings.ESP_Health then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and headScreen.Z > 1 then
                    local hp = hum.Health
                    local maxHp = hum.MaxHealth
                    if maxHp <= 0 then maxHp = 100 end
                    local hpRatio = math.clamp(hp / maxHp, 0, 1)
                    local hpColor = C3rgb(mfloor(255 * (1 - hpRatio)), mfloor(255 * hpRatio), 0)
                    local pos = Settings.ESP_HealthPos
                    local headY = headScreen.Y
                    local rootY = rootScreen.Y
                    local bodyH = math.max(10, rootY - headY)
                    local footY = rootY + bodyH
                    local charW = math.max(8, bodyH * 0.5)
                    local barLen = math.max(8, bodyH * 0.9)
                    local barThick = math.max(1.5, math.min(3, bodyH * 0.05))
                    local numSize = math.max(11, math.min(15, mfloor(bodyH * 0.4)))
                    
                    local offsetY = 0
                    if Settings.ESP_Name and pos == "Cima" then
                        offsetY = 22
                    end
                    
                    if Settings.ESP_HealthStyle == "Barra" then
                        local isVert = pos == "Esquerda" or pos == "Direita"
                        local bx, by
                        if pos == "Cima" then
                            bx = headScreen.X
                            by = headY - 12 + offsetY
                        elseif pos == "Baixo" then
                            bx = headScreen.X
                            by = footY + 6
                        elseif pos == "Esquerda" then
                            bx = headScreen.X - charW - 8
                            by = rootY
                        elseif pos == "Direita" then
                            bx = headScreen.X + charW + 8
                            by = rootY
                        else
                            bx = headScreen.X
                            by = headY - 34 + offsetY
                        end
                        
                        local outBg = acquireLine()
                        outBg.Color = BLACK
                        outBg.Thickness = barThick + 2
                        local bgBar = acquireLine()
                        bgBar.Color = C3rgb(40, 40, 40)
                        bgBar.Thickness = barThick
                        local fgBar = acquireLine()
                        fgBar.Color = hpColor
                        fgBar.Thickness = barThick
                        
                        if isVert then
                            local y1 = headY + offsetY
                            local y2 = footY + offsetY
                            local yFill = y1 + (y2 - y1) * (1 - hpRatio)
                            outBg.From = V2new(bx, y1)
                            outBg.To = V2new(bx, y2)
                            bgBar.From = V2new(bx, y1)
                            bgBar.To = V2new(bx, y2)
                            fgBar.From = V2new(bx, yFill)
                            fgBar.To = V2new(bx, y2)
                        else
                            local x1 = bx - barLen / 2
                            local x2 = bx + barLen / 2
                            outBg.From = V2new(x1, by)
                            outBg.To = V2new(x2, by)
                            bgBar.From = V2new(x1, by)
                            bgBar.To = V2new(x2, by)
                            fgBar.From = V2new(x1, by)
                            fgBar.To = V2new(x1 + barLen * hpRatio, by)
                        end
                    else
                        local tx, ty
                        if pos == "Cima" then
                            tx = headScreen.X
                            ty = headY - 12 + offsetY
                        elseif pos == "Baixo" then
                            tx = headScreen.X
                            ty = footY + 4
                        elseif pos == "Esquerda" then
                            tx = headScreen.X - charW - numSize * 2.5 - 6
                            ty = rootY - numSize / 2
                        elseif pos == "Direita" then
                            tx = headScreen.X + charW + 8
                            ty = rootY - numSize / 2
                        else
                            tx = headScreen.X
                            ty = headY - numSize - 22 + offsetY
                        end
                        
                        local ht = acquireText()
                        ht.Text = mfloor(hp) .. "/" .. mfloor(maxHp)
                        ht.Size = numSize
                        ht.Color = hpColor
                        ht.Center = (pos == "Cima" or pos == "Baixo")
                        ht.Outline = true
                        ht.OutlineColor = BLACK
                        ht.Position = V2new(tx, ty)
                    end
                end
            end
        end
    else
        for char, hl in pairs(boxHighlights) do
            pcall(function() hl:Destroy() end)
            boxHighlights[char] = nil
        end
    end
    
    hideLinePoolTail(linePoolIdx)
    hideTextPoolTail(textPoolIdx)
end)

-- ============================================
-- HEARTBEAT LOOP
-- ============================================
RunService.Heartbeat:Connect(function(delta)
    if not Injected then return end
    
    if ViewingPlayer then
        spectateTimer = spectateTimer + delta
        if spectateTimer >= 0.05 then
            spectateTimer = 0
            if SelectedPlayer and SelectedPlayer.Character then
                local hrp = SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    Camera.CameraSubject = hrp
                else
                    ViewingPlayer = false
                    Camera.CameraType = Enum.CameraType.Custom
                end
            end
        end
    end
    
    frameCount = frameCount + 1
    local now = tick()
    if now - lastFpsTime >= 1 then
        fps = frameCount
        frameCount = 0
        lastFpsTime = now
    end
    
    serverTimer = serverTimer + delta
    if serverTimer >= 1 then
        serverTimer = 0
        if playersCountLabel then playersCountLabel:Set("Jogadores: " .. #Players:GetPlayers()) end
        if pingLabel then
            local pingMs = mfloor(LocalPlayer:GetNetworkPing() * 1000)
            pingLabel:Set("Ping: " .. pingMs .. " ms")
        end
        if timeLabel then
            local ts = mfloor(workspace.DistributedGameTime)
            local h = mfloor(ts / 3600)
            local m = mfloor((ts % 3600) / 60)
            local s = ts % 60
            timeLabel:Set("Tempo: " .. (h > 0 and h .. "h " .. m .. "m " .. s .. "s" or m > 0 and m .. "m " .. s .. "s" or s .. "s"))
        end
        if Settings.ShowFPS and hudLabels["FPS"] then
            hudLabels["FPS"].Text = "FPS: " .. fps
        end
        if Settings.ShowPing and hudLabels["Ping"] then
            local pingMs = mfloor(LocalPlayer:GetNetworkPing() * 1000)
            hudLabels["Ping"].Text = "Ping: " .. pingMs .. " ms"
        end
        if Settings.ShowClock and hudLabels["Clock"] then
            hudLabels["Clock"].Text = osdate("Horário: %H:%M:%S")
        end
    end
    
    hudSlowTimer = hudSlowTimer + delta
    if hudSlowTimer >= 0.1 then
        hudSlowTimer = 0
        if Settings.ShowCoords and cachedHRP and hudLabels["Coords"] then
            local p = cachedHRP.Position
            hudLabels["Coords"].Text = "Coords: " .. mfloor(p.X) .. "," .. mfloor(p.Y) .. "," .. mfloor(p.Z)
        end
    end
    
    if Settings.GodMode and cachedHRP and cachedHum and cachedHum.Health > 0 then
        lastDeathPos = cachedHRP.CFrame
    end
    
    -- GRUDAR E ORBITAR
    if GluedToPlayer and SelectedPlayer then
        local targetHRP = SelectedPlayer.Character and SelectedPlayer.Character:FindFirstChild("HumanoidRootPart")
        if targetHRP and cachedHRP then
            cachedHRP.CFrame = targetHRP.CFrame + V3new(3, 0, 0)
        end
    end
    
    if OrbPlayer and SelectedPlayer and cachedHRP then
        local target = SelectedPlayer
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            orbAngle = orbAngle + delta * 2
            local radius = 8
            local tx = target.Character.HumanoidRootPart.Position
            local ox = tx + Vector3.new(math.cos(orbAngle) * radius, 0, math.sin(orbAngle) * radius)
            cachedHRP.CFrame = CFrame.new(ox, tx) * CFrame.new(0, 3, 0)
        end
    end
    
    -- SPEED, JUMP, NOCLIP, FLY
    if cachedHRP and cachedHum then
        if Settings.Speed then
            local moveVec = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVec = moveVec + cachedHRP.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVec = moveVec - cachedHRP.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVec = moveVec - cachedHRP.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVec = moveVec + cachedHRP.CFrame.RightVector end
            if moveVec.Magnitude > 0 then moveVec = moveVec.Unit end
            
            if Settings.SpeedMode == "CFrame" then
                cachedHRP.CFrame = cachedHRP.CFrame + moveVec * Settings.SpeedVal
            elseif Settings.SpeedMode == "Velocity" then
                cachedHum.WalkSpeed = Settings.SpeedVelVal
            elseif Settings.SpeedMode == "Híbrido" then
                cachedHum.WalkSpeed = Settings.SpeedVelVal * 0.5 + 8
                cachedHRP.CFrame = cachedHRP.CFrame + moveVec * (Settings.SpeedVal * 0.5)
            end
        else
            if cachedHum and cachedHum.WalkSpeed ~= 16 then
                cachedHum.WalkSpeed = 16
            end
        end
        
        if Settings.Jump then
            if cachedHum.UseJumpPower ~= true or cachedHum.JumpPower ~= Settings.JumpVal then
                cachedHum.UseJumpPower = true
                cachedHum.JumpPower = Settings.JumpVal
            end
        else
            if cachedHum.UseJumpPower ~= false or cachedHum.JumpPower ~= 50 then
                cachedHum.UseJumpPower = false
                cachedHum.JumpPower = 50
            end
        end
    end
    
    if Settings.Noclip then
        noclipTimer = noclipTimer + delta
        if noclipTimer >= 0.1 then
            noclipTimer = 0
            for i = 1, #noclipParts do
                local p = noclipParts[i]
                if p and p.Parent then p.CanCollide = false end
            end
        end
    else
        noclipTimer = 0
    end
    
    if Settings.Fly and cachedHRP then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = true end
        
        local bv = cachedHRP:FindFirstChild("SAV9_BV")
        local bg = cachedHRP:FindFirstChild("SAV9_BG")
        
        if not bv then
            bv = Instance.new("BodyVelocity", cachedHRP)
            bv.Name = "SAV9_BV"
            bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bv.Velocity = Vector3.zero
        end
        if not bg then
            bg = Instance.new("BodyGyro", cachedHRP)
            bg.Name = "SAV9_BG"
            bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            bg.P = 1e4
            bg.D = 100
        end
        
        local cam = workspace.CurrentCamera
        local moveDir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end
        if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
        
        bv.Velocity = moveDir * Settings.FlySpeed
        bg.CFrame = CFrame.new(Vector3.zero, cam.CFrame.LookVector * Vector3.new(1, 0, 1))
    elseif not Settings.Fly and cachedHRP then
        local bv = cachedHRP:FindFirstChild("SAV9_BV")
        local bg = cachedHRP:FindFirstChild("SAV9_BG")
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.PlatformStand and not Settings.Noclip then hum.PlatformStand = false end
    end
    
    if Settings.HitboxEnabled then
        for _, plr in pairs(Players:GetPlayers()) do
            pcall(function()
                if plr == LocalPlayer then return end
                if plr.Character then
                    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local isAlly = Settings.HitboxTeamCheck and LocalPlayer.Team ~= nil and plr.Team ~= nil and plr.Team == LocalPlayer.Team
                        if isAlly then
                            if hrp.Size.X > 2.1 then hrp.Size = Vector3.new(2, 2, 1) end
                            hrp.Transparency = 1
                            hrp.CanCollide = true
                        else
                            hrp.Size = Vector3.new(Settings.HitboxSize, Settings.HitboxSize, Settings.HitboxSize)
                            hrp.Transparency = Settings.HitboxTransp
                            hrp.LocalTransparencyModifier = 0
                            hrp.CanCollide = false
                        end
                    end
                end
            end)
        end
    end
    
    if Settings.SpinBot and cachedHRP then
        local spinStep = (Settings.SpinSpeed / 1000) * 2
        spinAngle = (spinAngle + spinStep) % mpi2
        local cf = cachedHRP.CFrame
        cachedHRP.CFrame = CFnew(cf.Position) * CFeuler(0, spinAngle, 0)
    end
    
    -- AUTOCLICK
    if Settings.AutoClick then
        autoClickTimer = autoClickTimer + delta * 1000
        if autoClickTimer >= Settings.AutoClickSpeed then
            autoClickTimer = 0
            local btn = Settings.AutoClickButton or "Esquerdo"
            local mx = Mouse.X
            local my = Mouse.Y
            
            if btn == "Esquerdo" then
                pcall(function() mouse1click() end)
                pcall(function()
                    UserInputService:SendMouseButtonEvent(mx, my, Enum.UserInputType.MouseButton1, true, game)
                    task.wait(0.01)
                    UserInputService:SendMouseButtonEvent(mx, my, Enum.UserInputType.MouseButton1, false, game)
                end)
            elseif btn == "Direito" then
                pcall(function()
                    UserInputService:SendMouseButtonEvent(mx, my, Enum.UserInputType.MouseButton2, true, game)
                    task.wait(0.01)
                    UserInputService:SendMouseButtonEvent(mx, my, Enum.UserInputType.MouseButton2, false, game)
                end)
                pcall(function() mouse2click() end)
            elseif btn == "Meio" then
                pcall(function()
                    UserInputService:SendMouseButtonEvent(mx, my, Enum.UserInputType.MouseButton3, true, game)
                    task.wait(0.01)
                    UserInputService:SendMouseButtonEvent(mx, my, Enum.UserInputType.MouseButton3, false, game)
                end)
            elseif #btn > 4 and btn:sub(1, 5) == "Tecla:" then
                local keyName = btn:sub(6)
                local kc = Enum.KeyCode[keyName]
                if kc then
                    pcall(function()
                        local vim = game:GetService("VirtualInputManager")
                        if vim then
                            vim:SendKeyEvent(true, kc, false, game)
                            task.wait(0.01)
                            vim:SendKeyEvent(false, kc, false, game)
                        end
                    end)
                    pcall(function()
                        UserInputService:SendKeyEvent(true, kc, false, game)
                        task.wait(0.01)
                        UserInputService:SendKeyEvent(false, kc, false, game)
                    end)
                    pcall(function()
                        if keypress then
                            keypress(kc)
                            task.wait(0.01)
                            keyrelease(kc)
                        end
                    end)
                end
            end
        end
    else
        autoClickTimer = 0
    end
    
    -- ANTI-FLING (não se aplica ao novo fling, pois ele não afeta o jogador de forma negativa)
    
    -- AIMBOT
    local v2ShouldRun = false
    if Settings.AimbotCam and not inLobby then
        if Settings.AimbotUseKeybind and Settings.AimbotBindKey ~= "None" then
            if Settings.AimbotKeyMode == "segurar" then
                v2ShouldRun = Settings.AimbotKeyActive and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            else
                v2ShouldRun = Settings.AimbotKeyActive and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
            end
        else
            v2ShouldRun = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        end
    end
    
    if Settings.AimbotCam and Settings.AimbotAutoFire and not inLobby then
        local afTarget = GetClosest()
        if afTarget and afTarget.Character then
            local afBoneMap = {["Cabeça"] = "Head", Peito = "UpperTorso", ["Perna Esquerda"] = "LeftUpperLeg"}
            local afBone = afTarget.Character:FindFirstChild(afBoneMap[Settings.AimbotBone] or "Head")
            if afBone then
                local sp = Camera:WorldToViewportPoint(afBone.Position)
                local mouse = UserInputService:GetMouseLocation()
                local dx = sp.X - mouse.X
                local dy = sp.Y - mouse.Y
                if math.sqrt(dx * dx + dy * dy) < 8 then
                    pcall(function() mouse1click() end)
                end
            end
        end
    end
    
    if v2ShouldRun then
        local target = GetClosest()
        if target and target.Character then
            local boneNameMap = {["Cabeça"] = "Head", Peito = "UpperTorso", ["Perna Esquerda"] = "LeftUpperLeg"}
            local boneName = boneNameMap[Settings.AimbotBone] or "Head"
            local bone = target.Character:FindFirstChild(boneName) or target.Character:FindFirstChild("Head")
            if bone then
                if Settings.AimbotVersion == "V2 (Câmera)" then
                    local camPos = Camera.CFrame.Position
                    local targetCF = CFrame.new(camPos, bone.Position)
                    local smooth = Settings.AimbotSmooth / 20
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF, smooth)
                else
                    local pos = Camera:WorldToViewportPoint(bone.Position)
                    local mouse = UserInputService:GetMouseLocation()
                    local _smooth = math.max(1, 21 - Settings.AimbotSmooth)
                    mousemoverel((pos.X - mouse.X) / _smooth, (pos.Y - mouse.Y) / _smooth)
                end
            end
        end
    end
end)

