LocalPlayer.CharacterAdded:Connect(function()
    refreshCharCache()
    refreshNoclipCache()
    if Settings.GodMode then connectGodMode(cachedHum) end
    if Settings.Speed then
        if cachedHum and Settings.SpeedMode == "Velocity" then
            cachedHum.WalkSpeed = Settings.SpeedVelVal
        end
    end
    if Settings.Jump then
        if cachedHum then
            cachedHum.UseJumpPower = true
            cachedHum.JumpPower = Settings.JumpVal
        end
    end
    -- Reativa o fling se estava ativo
    if Settings.FlingEnabled then
        task.wait(1.5)
        startFling()
    end
    if Settings.AggressiveFlingActive and Settings.AggressiveFlingTarget then
        task.wait(0.5)
        aggressiveFlingToggle(true, Settings.AggressiveFlingTarget)
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Enum.KeyCode.RightShift then
        MainUI:Toggle()
    end
end)

task.spawn(function()
    task.wait(0.5)
    pcall(function()
        if hudLabels["FPS"] then hudLabels["FPS"].Visible = Settings.ShowFPS end
        if hudLabels["Ping"] then hudLabels["Ping"].Visible = Settings.ShowPing end
        if hudLabels["Clock"] then hudLabels["Clock"].Visible = Settings.ShowClock end
        if hudLabels["Coords"] then hudLabels["Coords"].Visible = Settings.ShowCoords end
        if hudFrame then
            hudFrame.BackgroundTransparency = Settings.HUDBackground and (1 - Settings.HUDOpacity) or 1
            hudFrame.Position = UDim2new(0, Settings.HUDPosX, 0, Settings.HUDPosY)
        end
        NotificationSystem:Notify("SAV9 Universal", "Script carregado! v" .. SAV9_VERSION, 4, "success")
        print("SAV9 Universal v" .. SAV9_VERSION .. " carregado! Pressione RightShift")
        MainUI:Toggle()
    end)
end)

