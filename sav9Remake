local function removeTextures()
    if Settings.RemoveTextures then
        if not texturesRemoved then
            texturesRemoved = true
            for _, obj in pairs(workspace:GetDescendants()) do
                pcall(function()
                    if obj:IsA("SpecialMesh") or obj:IsA("FileMesh") then 
                        obj.TextureId = ""
                    elseif obj:IsA("Decal") or obj:IsA("Texture") then 
                        obj.Texture = ""
                    elseif obj:IsA("BasePart") then 
                        obj.Material = Enum.Material.SmoothPlastic
                        obj.CastShadow = false
                    end
                end)
            end
            pcall(function()
                for _, obj in pairs(Lighting:GetDescendants()) do
                    if obj:IsA("Sky") then obj:Destroy() end
                end
            end)
            NotificationSystem:Notify("Texturas", "Removidas para melhor performance!", 3, "success")
        end
    else
        texturesRemoved = false
        NotificationSystem:Notify("Texturas", "Restauradas!", 2, "success")
    end
end

