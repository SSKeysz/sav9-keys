local CONFIG_FOLDER = "PoloSniperFinal"
local AUTO_SAVE_INDEX_FILE = CONFIG_FOLDER .. "/auto_save_file.txt"

local function getConfigPath()
    local configFileName = nil
    if isfile(AUTO_SAVE_INDEX_FILE) then
        configFileName = readfile(AUTO_SAVE_INDEX_FILE):gsub("^%s+", ""):gsub("%s+$", "")
    end

    if configFileName == nil or configFileName == "" then
        local timestamp = tostring(os.time())
        local random = math.random(1000, 9999)
        configFileName = "auto_" .. timestamp .. "_" .. random .. ".json"
        pcall(function()
            if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
            writefile(AUTO_SAVE_INDEX_FILE, configFileName)
        end)
        NotificationSystem:Notify("Config", "Novo arquivo de configuração criado: " .. configFileName, 3, "success")
    end

    return CONFIG_FOLDER .. "/" .. configFileName
end

