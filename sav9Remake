            task.defer(function()
                pcall(startFling)
                if UIElements["FlingEnabled"] then UIElements["FlingEnabled"]:Set(true) end
            end)
        end
        if Settings.GodMode and cachedHum then
            pcall(function() connectGodMode(cachedHum) end)
            if UIElements["GodMode"] then UIElements["GodMode"]:Set(true) end
        end
        if Settings.Speed and cachedHum and Settings.SpeedMode == "Velocity" then
            pcall(function() cachedHum.WalkSpeed = Settings.SpeedVelVal end)
        end
        if Settings.Jump and cachedHum then
            pcall(function()
                cachedHum.UseJumpPower = true
                cachedHum.JumpPower = Settings.JumpVal
            end)
        end
        if Settings.Gravity ~= nil then
            pcall(function() workspace.Gravity = 196.2 * Settings.Gravity end)
        end

        if Settings.AggressiveFlingActive and Settings.AggressiveFlingTarget then
            task.defer(function()
                aggressiveFlingToggle(true, Settings.AggressiveFlingTarget)
            end)
        end

        NotificationSystem:Notify("Config", "Configurações carregadas! ("..loadedCount.." itens restaurados)", 3, "success")
    end)
end

