                           input.UserInputType == Enum.UserInputType.MouseButton3
            local isKeyboard = input.UserInputType == Enum.UserInputType.Keyboard
            
            if not isMouse and not isKeyboard then return end
            if isKeyboard and gp then return end
            
            if acButtonListener then
                pcall(function() acButtonListener:Disconnect() end)
                acButtonListener = nil
            end
            
            local name
            
            if isMouse then
                if input.UserInputType == Enum.UserInputType.MouseButton1 then 
                    name = "Esquerdo"
                elseif input.UserInputType == Enum.UserInputType.MouseButton2 then 
                    name = "Direito"
                elseif input.UserInputType == Enum.UserInputType.MouseButton3 then 
                    name = "Meio"
                else
                    name = "Esquerdo"
                end
            else
                name = "Tecla:" .. input.KeyCode.Name
            end
            
            Settings.AutoClickButton = name
            acButtonLabel:Set("Botão: " .. name)
            saveConfig()
            NotificationSystem:Notify("Botão definido!", "AutoClick: " .. name, 3, "success")
        end)
