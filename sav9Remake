-- ========== FLING AGRESSIVO (TOGGLE) ==========
local aggressiveFlingActive = false
local aggressiveFlingTarget = nil
local aggressiveFlingConnection = nil
local aggressiveFlingThrust = nil

local function aggressiveFlingStop()
    aggressiveFlingActive = false
    if aggressiveFlingConnection then
        pcall(function() aggressiveFlingConnection:Disconnect() end)
        aggressiveFlingConnection = nil
    end
    if aggressiveFlingThrust then
        pcall(function() aggressiveFlingThrust:Destroy() end)
        aggressiveFlingThrust = nil
    end
    Settings.AggressiveFlingActive = false
    Settings.AggressiveFlingTarget = nil
    saveConfig()
end

local function aggressiveFlingLoop(target)
    if not target or not target.Character then
        aggressiveFlingStop()
        return
    end
    
    local char = LocalPlayer.Character
    if not char then
        task.wait(0.5)
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        task.wait(0.5)
        return
    end
    
    if not aggressiveFlingThrust or not aggressiveFlingThrust.Parent then
        aggressiveFlingThrust = Instance.new("BodyThrust")
        aggressiveFlingThrust.Name = "SAV9_AggressiveFling"
        aggressiveFlingThrust.Force = Vector3.new(9999, 9999, 9999)
        aggressiveFlingThrust.Location = hrp.Position
        aggressiveFlingThrust.Parent = hrp
    end
    
    local targetHRP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if targetHRP then
        hrp.CFrame = targetHRP.CFrame
        aggressiveFlingThrust.Location = targetHRP.Position
    else
        task.wait(0.5)
    end
end

local function aggressiveFlingToggle(state, target)
    if state then
        if aggressiveFlingActive and aggressiveFlingTarget == target then
            aggressiveFlingStop()
            return
        end
        if not target then return end
        
        aggressiveFlingStop()
        
        aggressiveFlingActive = true
        aggressiveFlingTarget = target
        Settings.AggressiveFlingActive = true
        Settings.AggressiveFlingTarget = target
        saveConfig()
        
        if aggressiveFlingConnection then
            pcall(function() aggressiveFlingConnection:Disconnect() end)
            aggressiveFlingConnection = nil
        end
        aggressiveFlingConnection = RunService.Heartbeat:Connect(function()
            if not aggressiveFlingActive or not aggressiveFlingTarget then
                aggressiveFlingStop()
                return
            end
            aggressiveFlingLoop(aggressiveFlingTarget)
        end)
        
        NotificationSystem:Notify("Fling Agressivo", "Ativado contra " .. target.Name, 3, "success")
    else
        aggressiveFlingStop()
        NotificationSystem:Notify("Fling Agressivo", "Desativado", 2, "success")
    end
end

-- ============================================
-- FLING DE CONTATO (CÓDIGO OPENSOURCE COM VELOCIDADE REDUZIDA)
-- ============================================
local flingActive = false
local flingObjects = {}
local flingLoops = {}
local flingKeys = {w = false, a = false, s = false, d = false, space = false, shift = false}

local function stopFling()
    flingActive = false
    for _, conn in pairs(flingLoops) do
        pcall(function() conn:Disconnect() end)
    end
    flingLoops = {}
    for _, obj in pairs(flingObjects) do
        pcall(function() obj:Destroy() end)
    end
    flingObjects = {}
    local char = LocalPlayer.Character
    if char then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                v.Transparency = 0
                v.Material = Enum.Material.Plastic
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Running)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum.PlatformStand = false
        end
    end
    Camera.CameraSubject = char
    NotificationSystem:Notify("Fling", "Desativado - personagem restaurado.", 2, "success")
end

local function startFling()
    if flingActive then stopFling() end
    flingActive = true

    local char = LocalPlayer.Character
    if not char then
        NotificationSystem:Notify("Erro", "Personagem não encontrado.", 3, "error")
        flingActive = false
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        NotificationSystem:Notify("Erro", "HumanoidRootPart não encontrado.", 3, "error")
        flingActive = false
        return
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then
        NotificationSystem:Notify("Erro", "Humanoid não encontrado.", 3, "error")
        flingActive = false
        return
    end

    -- Reset keys
    flingKeys = {w = false, a = false, s = false, d = false, space = false, shift = false}

    -- 1. Cria a fake part
    local fakepart = Instance.new("Part", workspace)
    fakepart.Anchored = true
    fakepart.CanCollide = false
    fakepart.Transparency = 0.5
    fakepart.Size = Vector3.new(5, 5, 5)
    fakepart.Material = Enum.Material.ForceField
    fakepart.Position = hrp.Position
    table.insert(flingObjects, fakepart)

    -- 2. Attachments
    local att1 = Instance.new("Attachment", fakepart)
    local att2 = Instance.new("Attachment", hrp)
    table.insert(flingObjects, att1)
    table.insert(flingObjects, att2)

    -- 3. AlignPosition
    local align = Instance.new("AlignPosition")
    align.Attachment0 = att2
    align.Attachment1 = att1
    align.RigidityEnabled = true
    align.Responsiveness = math.huge
    align.MaxForce = Vector3.new(mhuge, mhuge, mhuge)
    align.MaxVelocity = math.huge
    align.MaxAxesForce = Vector3.new(mhuge, mhuge, mhuge)
    align.Visible = true
    align.Mode = Enum.PositionAlignmentMode.TwoAttachment
    align.Parent = fakepart
    table.insert(flingObjects, align)

    hum:ChangeState(Enum.HumanoidStateType.StrafingNoPhysics)

    -- 4. Teleport to high and back (preparação)
    local oldcf = hrp.CFrame
    hrp.CFrame = CFrame.new(Vector3.new(0, 40000000, 0)) * CFrame.fromEulerAnglesXYZ(math.rad(180), 0, 0)
    hrp.Velocity = Vector3.new(0, 1000000, 0)
    task.wait(3)
    hrp.Velocity = Vector3.new(0, 0, 0)
    hrp.CFrame = oldcf
    task.wait(0.2)

    -- 5. Aplica efeitos visuais (neon, transparência)
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
            v.Transparency = 0.75
            v.Material = Enum.Material.Neon
        elseif v:IsA("Decal") then
            v:Destroy()
        end
    end

    -- 6. Partícula
    local partic = Instance.new("ParticleEmitter", fakepart)
    partic.Texture = "rbxassetid://15273937357"
    partic.SpreadAngle = Vector2.new(-180, 180)
    partic.Rate = 45
    partic.Size = NumberSequence.new(1, 0)
    partic.Transparency = NumberSequence.new(0.9)
    partic.Lifetime = NumberRange.new(0.7, 1)
    partic.RotSpeed = NumberRange.new(-45, 45)
    table.insert(flingObjects, partic)

    -- 7. Loop de cores (thread separada)
    task.spawn(function()
        while flingActive do
            for i = 0, 1, 0.01 do
                if not flingActive then break end
                task.wait()
                local color = Color3.fromHSV(i, 1, 1)
                fakepart.Color = color
                if partic then partic.Color = ColorSequence.new(color) end
            end
        end
    end)

    -- 8. Loop de velocidades angulares
    local power = 100
    local attack = 5
    task.spawn(function()
        while flingActive do
            if hrp and hrp.Parent then
                hrp.AssemblyAngularVelocity = Vector3.new(
                    math.random(-500, 50),
                    math.random(-500, 500) * power,
                    math.random(-5, 5)
                )
            end
            task.wait(math.random(0, attack) / 50)
        end
    end)

    -- 9. Loop de snapping e velocidade linear
    task.spawn(function()
        while flingActive do
            if hrp and hrp.Parent and fakepart and fakepart.Parent then
                hrp.CFrame = fakepart.CFrame
                hrp.Velocity = Vector3.new(
                    math.random(-250, 250),
                    math.random(-500, 500),
                    math.random(-250, 250)
                )
            end
            task.wait()
        end
    end)

    -- 10. Movimento WASD + Espaço/Shift (velocidade reduzida para 0.5)
    local movementConn = RunService.Heartbeat:Connect(function()
        if not flingActive or not fakepart or not fakepart.Parent then
            movementConn:Disconnect()
            return
        end
        local cam = Camera
        local moveVec = Vector3.zero
        if flingKeys.w then moveVec = moveVec + cam.CFrame.LookVector end
        if flingKeys.s then moveVec = moveVec - cam.CFrame.LookVector end
        if flingKeys.a then moveVec = moveVec - cam.CFrame.RightVector end
        if flingKeys.d then moveVec = moveVec + cam.CFrame.RightVector end
        if flingKeys.space then moveVec = moveVec + Vector3.new(0, 1, 0) end
        if flingKeys.shift then moveVec = moveVec - Vector3.new(0, 1, 0) end
        
        if moveVec.Magnitude > 0 then
            moveVec = moveVec.Unit * 0.5  -- velocidade reduzida para 0.5
            fakepart.Position = fakepart.Position + moveVec
        end
    end)
    table.insert(flingLoops, movementConn)

    -- 11. Listeners de teclado
    local keyDownConn = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local key = input.KeyCode.Name:lower()
            if key == "w" or key == "a" or key == "s" or key == "d" then
                flingKeys[key] = true
            elseif key == "space" then
                flingKeys.space = true
            elseif key == "leftshift" or key == "rightshift" then
                flingKeys.shift = true
            end
        end
    end)
    table.insert(flingLoops, keyDownConn)

    local keyUpConn = UserInputService.InputEnded:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local key = input.KeyCode.Name:lower()
            if key == "w" or key == "a" or key == "s" or key == "d" then
                flingKeys[key] = false
            elseif key == "space" then
                flingKeys.space = false
            elseif key == "leftshift" or key == "rightshift" then
                flingKeys.shift = false
            end
        end
    end)
    table.insert(flingLoops, keyUpConn)

    -- 12. Estado do Humanoid (alterna Swimming/GettingUp)
    task.spawn(function()
        while flingActive do
            if hum and hum.Parent then
                hum:ChangeState(Enum.HumanoidStateType.Swimming)
                task.wait(0.5)
                if not flingActive then break end
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                task.wait(0.5)
            else
                break
            end
        end
    end)

    -- 13. Desativa FallingDown e pulo aleatório
    task.spawn(function()
        while flingActive do
            if hum and hum.Parent then
                hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                if math.random(0, 1) == 1 then
                    hum.Jump = true
                else
                    hum.Jump = false
                end
            end
            task.wait()
        end
    end)

    -- 14. Câmera segue a fake part
    Camera.CameraSubject = fakepart

    NotificationSystem:Notify("Fling", "Ativado! WASD = mover, Espaço = subir, Shift = descer (velocidade reduzida)", 3, "success")
end

function toggleFling()
    if flingActive then
        stopFling()
        Settings.FlingEnabled = false
        if UIElements["FlingEnabled"] then UIElements["FlingEnabled"]:Set(false) end
        saveConfig()
    else
        startFling()
        Settings.FlingEnabled = true
        if UIElements["FlingEnabled"] then UIElements["FlingEnabled"]:Set(true) end
        saveConfig()
    end
end

