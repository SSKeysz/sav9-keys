function MainUI:CreateSlider(tabId, name, min, max, increment, defaultValue, callback, flag)
    local tab = self:GetTabContainer(tabId)
    if not tab then return nil end
    local container = Instance.new("Frame", tab.container)
    container.Size = UDim2.new(1, 0, 0, 54)
    container.BackgroundColor3 = Theme.Card
    container.BackgroundTransparency = 0.2
    container.BorderSizePixel = 0
